# Copy to .env. With nothing set, the site runs in demo mode.

# --- your coin ---
COIN_MINT=
COIN_SYMBOL=CALLOUT
# Leave empty for https://x.com/calloutonpmp
X_URL=

# --- callouts (no keys) ---
# gmgn lists every callout on the coin; it is read this often. 10s stays well clear of its rate limit.
GMGN_POLL_MS=10000
# Leave empty for https://gmgn.ai (finds callouts) and https://frontend-api-v3.pump.fun (judges them)
GMGN_BASE=
PUMP_FRONTEND_BASE=
# Callouts before this moment never earn. Empty = first boot.
REWARDS_START=

# --- Solana ---
RPC_URL=https://api.mainnet-beta.solana.com
# Watch-only: shows the pot without being able to spend it.
TREASURY_PUBKEY=
# The creator wallet's key (base58 or JSON array). Anyone with this file can spend the wallet.
TREASURY_SECRET_KEY=
# Nothing is ever sent until this is exactly "true".
LIVE_PAYOUTS=false

# --- burns: buyback (buy the coin with $PUMP, burn the coin) or direct (burn $PUMP) ---
BURN_MODE=buyback
MIN_BURN_PUMP=250

# --- reward rules (defaults shown) ---
REWARD_BPS=8000
MAX_POT_SHARE_BPS=250
BASE_SCORE=0.2
BAG_WEIGHT=0.5
HOLD_STREAK_RATE=0.1
HOLD_STREAK_CAP=3
HOLD_FULL_BPS=200
HOLD_EXPONENT=0.75
MIN_HOLD_BPS=10
FOLLOWERS_FULL=10000
MIN_FOLLOWERS=10
MIN_ACCOUNT_AGE_DAYS=0
HOLD_MINUTES=10
COOLDOWN_MINUTES=10
MIN_PAYOUT_PUMP=100
POT_FLOOR_PUMP=5000
QUEUE_AGING_PER_HOUR=0.05
QUEUE_AGING_CAP=2
QUEUE_EXPIRY_DAYS=7
# Comma-separated wallets that can never earn (team, market maker). The treasury is always excluded.
EXCLUDE_WALLETS=

# --- server ---
PORT=8787
HOST=127.0.0.1
# true when a reverse proxy sits in front
TRUST_PROXY=false
