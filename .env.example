# Copy to .env. With nothing set (and NODE_ENV not production), the site runs in demo mode with invented coins.

# --- site ---
SITE_NAME=Holler
# Public address of the site, for coin metadata hosted here when pump.fun's upload is unavailable.
SITE_URL=https://holler.lol
# The site's X account; empty hides the link.
X_URL=

# --- the launchpad wallet ---
# A NEW wallet used only by this site. It co-signs launches and receives, swaps, pays and burns every coin's fees.
# Fund it with ~0.1 SOL before the first launch. Anyone with this key can spend the wallet.
LAUNCHPAD_SECRET_KEY=
# Nothing is ever sent until this is exactly "true".
LIVE_PAYOUTS=false
RPC_URL=https://api.mainnet-beta.solana.com
# Swaps SOL to USDC and buys coins back to burn. Get a key at https://portal.jup.ag
JUPITER_API_KEY=

# --- the platform coin ---
# Launch it through the site like any coin, then paste its mint here. It keeps all its own fees and gets
# PLATFORM_PCT of every other coin's. Until it is set, that share waits in the launchpad wallet.
PLATFORM_MINT=

# --- fees: how every coin's SOL creator fees split. Must add up to 100. ---
CALLER_PCT=60
BURN_PCT=10
PLATFORM_PCT=30
# Paid by the launcher into the launchpad wallet; covers network fees for that coin's payouts.
LAUNCH_FEE_SOL=0.05
MAX_DEV_BUY_SOL=50
# A coin's fees are claimed once at least this much SOL is waiting, and swapped to USDC from this much.
MIN_CLAIM_SOL=0.02
MIN_SWAP_SOL=0.05
SWAP_SLIPPAGE_BPS=100
# SOL the wallet keeps for itself, on top of what coins are owed.
MIN_SOL_RESERVE=0.05

# --- reward rules (defaults shown; amounts in USDC) ---
MAX_POT_SHARE_BPS=250
BASE_SCORE=0.2
BAG_WEIGHT=0.5
HOLD_STREAK_RATE=0.1
HOLD_STREAK_CAP=3
HOLD_FULL_BPS=200
HOLD_EXPONENT=0.75
MIN_HOLD_BPS=10
FOLLOWERS_FULL=10000
MIN_FOLLOWERS=10
MIN_ACCOUNT_AGE_DAYS=0
HOLD_MINUTES=2
COOLDOWN_MINUTES=10
MIN_PAYOUT_USDC=0.5
POT_FLOOR_USDC=25
MIN_BURN_USDC=5
QUEUE_AGING_PER_HOUR=0.05
QUEUE_AGING_CAP=2
QUEUE_EXPIRY_DAYS=7
# Comma-separated wallets that can never earn (team, market maker). Launchers and the launchpad wallet always are.
EXCLUDE_WALLETS=
# Comma-separated coin mints to leave off the site. They keep running: fees, swaps and payouts carry on.
HIDE_COINS=

# --- server ---
PORT=8787
HOST=127.0.0.1
DATA_DIR=data
# true when a reverse proxy sits in front
TRUST_PROXY=false
