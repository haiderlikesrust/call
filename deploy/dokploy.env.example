# Paste into the application's Environment tab in Dokploy. Do not commit filled-in values.
# With nothing filled in, the site deploys as a closed launchpad: real site, no coins, nothing invented.
# HOST, PORT, NODE_ENV, TRUST_PROXY and DATA_DIR are set by the image. Leave them out.

SITE_NAME=Holler
SITE_URL=https://holler.lol
X_URL=

# A paid mainnet RPC (Helius, Triton, QuickNode).
RPC_URL=
# A NEW wallet only this site uses. Base58 or a JSON array of 64 bytes.
LAUNCHPAD_SECRET_KEY=
# Keep false until "npm run doctor" is all green and a rehearsal looks right.
LIVE_PAYOUTS=false
JUPITER_API_KEY=

# The platform coin's mint, once it is launched through the site.
PLATFORM_MINT=

CALLER_PCT=60
BURN_PCT=10
PLATFORM_PCT=30
LAUNCH_FEE_SOL=0.05
EXCLUDE_WALLETS=

# true only for a public demo with invented data (the site says so in a banner).
DEMO=false
