# Paste into the application's Environment tab in Dokploy. Do not commit filled-in values.
# With nothing filled in, the site deploys in "prelaunch": real site, empty, nothing invented.
# HOST, PORT, NODE_ENV, TRUST_PROXY and DB_PATH are set by the image. Leave them out.

COIN_MINT=
COIN_SYMBOL=CALLOUT
# Leave empty for https://x.com/calloutonpmp
X_URL=

# https://developers.pump.fun
PUMP_API_KEY=
POLL_MS=2500
PUMP_DAILY_BUDGET=50000
REWARDS_START=

# A paid mainnet RPC (Helius, Triton, QuickNode).
RPC_URL=
# Rehearsal: the wallet to watch. No key needed.
TREASURY_PUBKEY=
# Live: the coin's creator wallet. Base58 or a JSON array of 64 bytes.
TREASURY_SECRET_KEY=
# Keep false until `npm run doctor` is all green and a rehearsal looks right.
LIVE_PAYOUTS=false

BURN_MODE=buyback
JUPITER_API_KEY=
EXCLUDE_WALLETS=

# true only for a public demo with invented data (the site says so in a banner).
DEMO=false
