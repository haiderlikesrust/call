{
  "name": "callout",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "vite web",
    "build": "vite build web",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "doctor": "node --env-file-if-exists=.env server/doctor.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.3.1",
    "@pump-fun/pump-swap-sdk": "2.2.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/bagel-fat-one": "^5.3.0",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
